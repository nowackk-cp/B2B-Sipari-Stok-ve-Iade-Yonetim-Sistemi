{
  "name": "@b2b/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed API client consumed by the web app. OpenAPI-generated types are wired in TASK-015.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "generate": "openapi-typescript ../../apps/api/openapi.json -o src/generated/schema.ts",
    "clean": "node -e \"['dist','.turbo','tsconfig.build.tsbuildinfo','tsconfig.tsbuildinfo'].forEach(p=>require('fs').rmSync(p,{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@b2b/shared": "workspace:*"
  },
  "devDependencies": {
    "openapi-typescript": "7.4.4",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
