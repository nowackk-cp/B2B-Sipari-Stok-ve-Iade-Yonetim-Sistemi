// B2B Operations Suite — Prisma schema.
//
// Authority: docs/architecture/DATABASE_DESIGN.md. This schema implements the
// full persistence model (identity, RBAC, scope, catalog, inventory, orders,
// returns, billing, imports, outbox/effects, audit). Conventions:
//   - PK: BigInt identity (sequential, index-friendly). Externally-addressable
//     aggregates additionally expose a `publicId UUID` to avoid leaking
//     sequential ids over the public API (SECURITY_MODEL IDOR / §4).
//   - Time: every timestamp is `timestamptz` (UTC). created/updated_at standard.
//   - Money: BigInt minor unit + CHAR(3) ISO currency. Tax/discount = basis pts.
//   - Soft delete: `deletedAt` only on the master-data tables listed in §16.
//
// CHECK constraints, append-only triggers, updated_at triggers, partial-unique
// indexes and extensions (citext / pg_trgm / pgcrypto) are NOT expressible in
// Prisma and are applied via hand-written SQL appended to the generated
// migration (see prisma/migrations + DATABASE_DESIGN.md §17/§22).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (DATABASE_DESIGN §0) — PostgreSQL native enums.
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED

  @@map("user_status")
}

enum OrderStatus {
  DRAFT
  APPROVED
  PREPARING
  SHIPPED
  CANCELLED

  @@map("order_status")
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED

  @@map("reservation_status")
}

enum LedgerChangeType {
  RECEIPT
  SHIPMENT
  TRANSFER_OUT
  TRANSFER_IN
  RETURN_IN
  ADJUSTMENT

  @@map("ledger_change_type")
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED

  @@map("transfer_status")
}

enum ReturnStatus {
  DRAFT
  APPROVED
  RECEIVED
  REJECTED
  COMPLETED

  @@map("return_status")
}

enum ReturnCondition {
  RESELLABLE
  DAMAGED

  @@map("return_condition")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID

  @@map("invoice_status")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED

  @@map("quote_status")
}

enum DocumentType {
  INVOICE
  CREDIT_NOTE

  @@map("document_type")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("job_status")
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED

  @@map("email_status")
}

enum AddressType {
  BILLING
  SHIPPING

  @@map("address_type")
}

enum ImportStatus {
  UPLOADED
  VALIDATING
  VALIDATED
  IMPORTING
  COMPLETED
  VALIDATION_FAILED
  IMPORT_FAILED
  CANCELLED

  @@map("import_status")
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  APPLIED
  SKIPPED

  @@map("import_row_status")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD

  @@map("outbox_status")
}

enum EffectStatus {
  PLANNED
  IN_PROGRESS
  SUCCEEDED
  FAILED
  UNKNOWN

  @@map("effect_status")
}

// Lifecycle of a single password-reset email delivery (AUTH-BLOCK-001). Mirrors
// the ADR-008 effect-state model so a crash never loses or duplicates the email:
// the encrypted secret survives until a provider send actually SUCCEEDED.
enum PasswordResetDeliveryStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  FAILED
  UNKNOWN

  @@map("password_reset_delivery_status")
}

// ---------------------------------------------------------------------------
// Organisation / system
// ---------------------------------------------------------------------------

model Company {
  id              BigInt   @id @default(autoincrement())
  name            String
  legalName       String?  @map("legal_name")
  taxNumber       String?  @map("tax_number")
  defaultCurrency String   @default("TRY") @map("default_currency") @db.Char(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoiceSeries InvoiceSeries[]
  invoices      Invoice[]
  importJobs    ImportJob[]
  // RBAC tenancy (TASK-010b): users and roles are company-scoped. No role is
  // global/assignable without a company — tenant isolation is a DB invariant.
  users         User[]
  roles         Role[]
  // Warehouse scope (TASK-010c): warehouses are company-scoped so a user's
  // warehouse access can never straddle tenants. Composite FKs on
  // user_warehouse_scopes pin user.company_id = warehouse.company_id.
  warehouses    Warehouse[]
  // Catalog (TASK-011): products are company-scoped master data. The same SKU
  // may exist in different companies; within one company it is unique among
  // active rows (partial unique `(company_id, sku) WHERE deleted_at IS NULL`).
  products      Product[]
  // Customers (Customer Management Foundation): customer cards are company-scoped
  // master data, same tenant model as products/warehouses. The same code may
  // exist across companies; within one company it is unique among active rows.
  customers     Customer[]
  // Orders (Order Draft Foundation): orders are company-scoped transaction data.
  // The order→company FK RESTRICTs, and the (id, company_id) composite-unique
  // targets pin each order's customer/warehouse/items to the SAME tenant.
  orders        Order[]
  // Authorization cache version (PG-004): the per-company monotonic counter that
  // anchors the effective-permission cache key. Maintained entirely by DB
  // triggers (migration 20260616030000_authorization_cache_version).
  authzVersion  CompanyAuthzVersion?

  @@map("companies")
}

/// Per-company authorization version (PG-004).
///
/// A single monotonic counter per company that participates in the
/// effective-permission cache key (`companyId:userId:authzVersion:securityVersion`).
/// Every change that can alter a user's effective permissions (user_roles,
/// role_permissions, role and permission-relevant user changes) bumps the owning
/// company's counter inside the SAME transaction as the change, via DB triggers —
/// so the bump commits/rolls back atomically and reaches every API instance
/// (PostgreSQL is the single source of truth, never a JWT claim). A reader loads
/// the current value before each cache lookup; once it moves, the old key can
/// never be read again on ANY node, even without an explicit local cache clear.
///
/// Rows are created by trigger for every company (AFTER INSERT) and backfilled
/// for existing ones; the `version`/`updated_at` columns are written ONLY by the
/// triggers, never by application code.
model CompanyAuthzVersion {
  companyId BigInt   @id @map("company_id")
  version   BigInt   @default(1)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_authz_versions")
}

model SystemSetting {
  key       String   @id
  value     Json     @db.JsonB
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// M1 Identity & Auth
// ---------------------------------------------------------------------------

model User {
  id                BigInt     @id @default(autoincrement())
  publicId          String     @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  // Owning tenant. Every user belongs to exactly one company; effective
  // permissions are resolved ONLY through same-company roles (SECURITY_MODEL,
  // TASK-010b). The principal's company is read from here, never from a JWT claim.
  companyId         BigInt     @map("company_id")
  email             String     @unique @db.Citext
  passwordHash      String     @map("password_hash")
  fullName          String     @map("full_name")
  status            UserStatus @default(INVITED)
  // Account-security state (TASK-009 §11). `failedLoginCount`/`lockedUntil` are
  // the authoritative, durable brute-force lockout (Redis is never the source of
  // truth). `passwordChangedAt` supports "changed since" session policies.
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  roles               UserRole[]           @relation("UserRoleUser")
  rolesAssigned       UserRole[]           @relation("UserRoleAssignedBy")
  warehouseScopes     UserWarehouseScope[] @relation("UserWarehouseScopeUser")
  scopesGranted       UserWarehouseScope[] @relation("UserWarehouseScopeGrantedBy")
  permissionGrants    RolePermission[]     @relation("RolePermissionGrantedBy")
  notifications       Notification[]

  ordersCreated          Order[]                 @relation("OrderCreatedBy")
  ordersApproved         Order[]                 @relation("OrderApprovedBy")
  orderShipmentsCreated  OrderShipment[]         @relation("OrderShipmentCreatedBy")
  orderStatusChanges     OrderStatusHistory[]    @relation("OrderStatusHistoryChangedBy")
  priceOverridesActor    OrderPriceOverride[]    @relation("OrderPriceOverrideActor")
  priceOverridesApprover OrderPriceOverride[]    @relation("OrderPriceOverrideApprovedBy")
  ledgerEntries          StockLedger[]           @relation("StockLedgerCreatedBy")
  transfersCreated       StockTransfer[]         @relation("StockTransferCreatedBy")
  transferRecordsCreated StockTransferRecord[]   @relation("StockTransferRecordCreatedBy")
  transferStatusChanges  TransferStatusHistory[] @relation("TransferStatusHistoryChangedBy")
  returnsCreated         Return[]                @relation("ReturnCreatedBy")
  returnStatusChanges    ReturnStatusHistory[]   @relation("ReturnStatusHistoryChangedBy")
  invoicesCreated        Invoice[]               @relation("InvoiceCreatedBy")
  invoiceStatusChanges   InvoiceStatusHistory[]  @relation("InvoiceStatusHistoryChangedBy")
  quotesCreated          Quote[]                 @relation("QuoteCreatedBy")
  paymentsRecorded       Payment[]               @relation("PaymentCreatedBy")
  filesUploaded          File[]                  @relation("FileUploadedBy")
  importJobsCreated      ImportJob[]             @relation("ImportJobCreatedBy")
  exportJobsCreated      ExportJob[]             @relation("ExportJobCreatedBy")
  auditLogs              AuditLog[]              @relation("AuditLogActor")

  // Composite-FK target so user_roles.(user_id, company_id) can reference it and
  // pin every assignment to this user's own tenant.
  @@unique([id, companyId])
  @@index([status])
  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id            BigInt    @id @default(autoincrement())
  // Externally-addressable session id (used by GET/DELETE /auth/sessions); the
  // sequential PK is never exposed (API_CONVENTIONS §7b / IDOR). NOT unique per
  // row: every token in a rotation chain shares one stable session id.
  sessionId     String    @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid
  userId        BigInt    @map("user_id")
  // SHA-256 digest of the opaque token. The plaintext token is NEVER stored.
  tokenHash     String    @unique @map("token_hash")
  // Rotation chain / theft-detection: every token in one login lineage shares a
  // family id; a rotated token points to its successor via replacedById.
  tokenFamilyId String    @map("token_family_id") @db.Uuid
  replacedById  BigInt?   @map("replaced_by_token_id")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason  String?   @map("revoke_reason")
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  userAgent     String?   @map("user_agent")
  ip            String?   @db.Inet
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken[] @relation("RefreshTokenReplacement")

  @@index([userId])
  @@index([sessionId])
  @@index([tokenFamilyId])
  // Active-session lookup / expiry cleanup.
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id                     BigInt                      @id @default(autoincrement())
  userId                 BigInt                      @map("user_id")
  // SHA-256 digest of the single-use reset token; plaintext is never stored.
  // Verification (consume) uses this digest only.
  tokenHash              String                      @unique @map("token_hash")
  expiresAt              DateTime                    @map("expires_at") @db.Timestamptz(6)
  consumedAt             DateTime?                   @map("consumed_at") @db.Timestamptz(6)
  requestedByIp          String?                     @map("requested_by_ip") @db.Inet
  // Deliverable bearer secret, envelope-encrypted with AES-256-GCM (key is
  // env-only, never in the DB). The raw token is NEVER stored in plaintext. The
  // mail dispatcher claims the row (lease), decrypts these IN MEMORY to send the
  // link, and only NULLs all three AFTER the provider has actually accepted the
  // email. A crash before the provider call therefore preserves the secret so a
  // retry can rebuild the email (AUTH-BLOCK-001, crash-loss fix).
  deliveryCiphertext     Bytes?                      @map("delivery_ciphertext")
  deliveryNonce          Bytes?                      @map("delivery_nonce")
  deliveryAuthTag        Bytes?                      @map("delivery_auth_tag")
  // Lease-based delivery state (ADR-008 effect-state model). `deliveryStatus`
  // (not `deliveryConsumedAt`) is the source of truth for delivery success; the
  // lease lets another worker re-claim a crashed in-flight attempt once it lapses.
  deliveryStatus         PasswordResetDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryLeaseUntil     DateTime?                   @map("delivery_lease_until") @db.Timestamptz(6)
  deliveryAttemptCount   Int                         @default(0) @map("delivery_attempt_count")
  // Stamped immediately BEFORE the provider send is attempted, fenced by the
  // claim token. It is the commit point that makes a non-idempotent send (SMTP)
  // crash-safe: once set, a lapsed in-flight row is NOT auto-reclaimed (a second
  // sendMail could deliver a duplicate). Recovery quarantines such a row as
  // UNKNOWN for manual review instead. NULL means the provider was never called,
  // so the row stays freely re-claimable (AUTH-RESET-DELIVERY-003).
  deliverySendStartedAt  DateTime?                   @map("delivery_send_started_at") @db.Timestamptz(6)
  // Fencing token: a fresh CSPRNG value minted on every successful claim. A
  // finalizer (markDelivered/Failed/Unknown) must present the token it claimed
  // with; once a newer worker re-claims, the token rotates and the stale worker's
  // conditional update matches zero rows — it can no longer overwrite the row.
  deliveryClaimToken     String?                     @map("delivery_claim_token")
  providerIdempotencyKey String?                     @map("provider_idempotency_key")
  providerMessageId      String?                     @map("provider_message_id")
  deliveredAt            DateTime?                   @map("delivered_at") @db.Timestamptz(6)
  deliveryLastError      String?                     @map("delivery_last_error")
  // Deprecated: kept for migration history only. No longer written and never the
  // source of delivery success (it could be stamped before the email was sent).
  deliveryConsumedAt     DateTime?                   @map("delivery_consumed_at") @db.Timestamptz(6)
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([deliveryStatus, deliveryLeaseUntil])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// M2 Authorization
// ---------------------------------------------------------------------------

model Role {
  id             BigInt   @id @default(autoincrement())
  // Owning tenant. Roles are ALWAYS company-scoped — there is no global/null
  // assignable role. The same role name (e.g. ADMIN) exists as a distinct row
  // per company; being protected/system never bypasses this tenant boundary.
  companyId      BigInt   @map("company_id")
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  isProtected    Boolean  @default(false) @map("is_protected")
  privilegeLevel Int      @default(0) @map("privilege_level")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]

  // Role identity is (company, name): same name allowed across companies.
  @@unique([companyId, name])
  // Composite-FK target so user_roles.(role_id, company_id) references it.
  @@unique([id, companyId])
  @@index([companyId])
  @@map("roles")
}

model Permission {
  id              BigInt   @id @default(autoincrement())
  code            String   @unique
  module          String
  permissionGroup String   @map("permission_group")
  description     String?
  isProtected     Boolean  @default(false) @map("is_protected")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@index([permissionGroup])
  @@map("permissions")
}

model RolePermission {
  roleId       BigInt   @map("role_id")
  permissionId BigInt   @map("permission_id")
  grantedById  BigInt?  @map("granted_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("RolePermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       BigInt   @map("user_id")
  roleId       BigInt   @map("role_id")
  // Tenant the assignment belongs to. Carried explicitly (not derived) so the
  // two composite FKs below force user.company_id = role.company_id = this value
  // at the DB level — a cross-company assignment is rejected by PostgreSQL, not
  // merely by application code.
  companyId    BigInt   @map("company_id")
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedById BigInt?  @map("assigned_by")

  // Composite FKs pin both endpoints to the SAME company. `companyId` is the
  // shared key, so user, role and assignment can never straddle two tenants.
  // onDelete: Restrict (RBAC-TI-002): deleting a user/role that still owns
  // assignments is REFUSED by PostgreSQL rather than silently cascading away the
  // authorization state. The assignment must be removed first (auditable). See
  // migration 20260616020000_rbac_user_roles_delete_restrict.
  user       User  @relation("UserRoleUser", fields: [userId, companyId], references: [id, companyId], onDelete: Restrict)
  role       Role  @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Restrict)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  // PK (user_id, role_id) already forbids a duplicate user-role-company row.
  @@id([userId, roleId])
  @@index([roleId])
  @@index([companyId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// M3 Scope
// ---------------------------------------------------------------------------

// Explicit, per-warehouse access grant (TASK-010c / SECURITY_MODEL §3). A user's
// warehouse access comes ONLY from (1) a row here or (2) the protected
// `warehouse:scope:all` permission — never implicitly from a role name (ADMIN
// included). `companyId` is carried explicitly so the two composite FKs below
// force user.company_id = warehouse.company_id = this value at the DB level: a
// cross-company grant (user in A, warehouse in B) is physically un-insertable,
// not merely rejected by application code.
//
// Hard delete (no `deletedAt`): a scope grant is current-state authorization
// data, not an append-only ledger/audit row. Revocation removes the row; the
// change is invalidated immediately by the per-company `authzVersion` bump
// trigger (and surfaced by security logging in the management layer). This
// mirrors how `user_roles` assignments are managed. The PK (user_id,
// warehouse_id) makes a duplicate active grant impossible.
model UserWarehouseScope {
  userId      BigInt   @map("user_id")
  warehouseId BigInt   @map("warehouse_id")
  // Tenant the grant belongs to (NOT NULL). Shared key of both composite FKs.
  companyId   BigInt   @map("company_id")
  scopeType   String   @default("EXPLICIT") @map("scope_type")
  // Who created the grant. Nullable + SetNull so removing the granter never
  // silently erases the grant nor blocks the granter's own lifecycle.
  grantedById BigInt?  @map("granted_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Composite FKs pin both endpoints to the SAME company. onDelete: Restrict —
  // hard-deleting a user/warehouse that still owns a scope is REFUSED, never a
  // silent cascade that drops the authorization grant (SECURITY_MODEL §3, rule 5).
  user      User      @relation("UserWarehouseScopeUser", fields: [userId, companyId], references: [id, companyId], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId, companyId], references: [id, companyId], onDelete: Restrict)
  grantedBy User?     @relation("UserWarehouseScopeGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, warehouseId])
  @@index([warehouseId])
  @@index([companyId])
  @@map("user_warehouse_scopes")
}

// ---------------------------------------------------------------------------
// M4 Catalog
// ---------------------------------------------------------------------------

model Category {
  id        BigInt    @id @default(autoincrement())
  name      String
  parentId  BigInt?   @map("parent_id")
  slug      String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryParent")
  products Product[]

  @@unique([slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id                     BigInt    @id @default(autoincrement())
  publicId               String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  // Owning tenant (NOT NULL). Products are company-scoped master data; the SKU
  // uniqueness, every list/get and all mutations are filtered by this company,
  // resolved from the PostgreSQL principal — never a JWT claim (TASK-011).
  companyId              BigInt    @map("company_id")
  sku                    String
  name                   String
  // Free-text product-card description (TASK-011). Nullable.
  description            String?
  categoryId             BigInt?   @map("category_id")
  barcode                String?
  unit                   String    @default("EACH")
  listPriceAmount        BigInt    @default(0) @map("list_price_amount")
  currency               String    @default("TRY") @db.Char(3)
  taxRateBp              Int       @default(2000) @map("tax_rate_bp")
  // Optional low-stock alert threshold for the product card (TASK-011). This is a
  // catalog attribute, NOT a stock quantity — actual on-hand/reserved live in the
  // inventory module (CLAUDE rule 20). Nullable; CHECK enforces >= 0 when set.
  criticalStockThreshold BigInt?   @map("critical_stock_threshold")
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  orderItems         OrderItem[]
  stockBalances      StockBalance[]
  stockLedgerEntries StockLedger[]
  reservations       StockReservation[]
  transferItems      StockTransferItem[]
  transferRecords    StockTransferRecord[]
  returnItems        ReturnItem[]
  invoiceItems       InvoiceItem[]
  quoteItems         QuoteItem[]

  // SKU identity is (company, sku): the same SKU may exist across companies.
  // The init/TASK-011 migration converts this to a PARTIAL unique
  // (`WHERE deleted_at IS NULL`), preserving the index name, so a soft-deleted
  // product's SKU becomes reusable within the same company.
  @@unique([companyId, sku], map: "products_sku_key")
  // Composite-FK target so stock_transfer_records.(product_id, company_id)
  // references it and pins every atomic transfer to the product's own tenant
  // (Stock Transfer Foundation), mirroring the warehouse (id, company_id) target.
  @@unique([id, companyId])
  @@index([companyId])
  @@index([categoryId])
  @@index([isActive])
  @@index([barcode])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}

// ---------------------------------------------------------------------------
// M5 Warehouses
// ---------------------------------------------------------------------------

model Warehouse {
  id           BigInt    @id @default(autoincrement())
  publicId     String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  // Owning tenant (NOT NULL). Warehouses are company-scoped so warehouse access
  // never crosses tenants; the (id, company_id) unique below is the composite-FK
  // target that user_warehouse_scopes pins against (TASK-010c).
  companyId    BigInt    @map("company_id")
  code         String
  name         String
  addressLine1 String?   @map("address_line1")
  addressLine2 String?   @map("address_line2")
  city         String?
  postalCode   String?   @map("postal_code")
  country      String?   @db.Char(2)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  company            Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  stockBalances      StockBalance[]
  stockLedgerEntries StockLedger[]
  reservations       StockReservation[]
  scopes             UserWarehouseScope[]
  transfersOut       StockTransfer[]       @relation("TransferSource")
  transfersIn        StockTransfer[]       @relation("TransferDest")
  transferRecordsOut StockTransferRecord[] @relation("StockTransferRecordSource")
  transferRecordsIn  StockTransferRecord[] @relation("StockTransferRecordDest")
  orders             Order[]
  orderShipments     OrderShipment[]
  invoices           Invoice[]

  // Warehouse code identity is (company, code): the same code may exist across
  // companies. The TASK-012 management migration converts this to a PARTIAL
  // unique (`WHERE deleted_at IS NULL`), preserving the index name, so within one
  // company an active code is unique while a soft-deleted warehouse frees its
  // code for reuse (matches the products SKU convention).
  @@unique([companyId, code], map: "warehouses_code_key")
  // Composite-FK target so user_warehouse_scopes.(warehouse_id, company_id)
  // references it and pins every scope to the warehouse's own tenant.
  @@unique([id, companyId])
  @@index([companyId])
  @@map("warehouses")
}

// ---------------------------------------------------------------------------
// M6 Inventory
// ---------------------------------------------------------------------------

model StockBalance {
  id          BigInt   @id @default(autoincrement())
  productId   BigInt   @map("product_id")
  warehouseId BigInt   @map("warehouse_id")
  onHand      BigInt   @default(0) @map("on_hand")
  reserved    BigInt   @default(0)
  version     Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@map("stock_balances")
}

model StockLedger {
  id              BigInt           @id @default(autoincrement())
  productId       BigInt           @map("product_id")
  warehouseId     BigInt           @map("warehouse_id")
  changeType      LedgerChangeType @map("change_type")
  quantity        BigInt
  balanceAfter    BigInt           @map("balance_after")
  referenceType   String           @map("reference_type")
  referenceId     BigInt?          @map("reference_id")
  referenceLineId BigInt?          @map("reference_line_id")
  idempotencyKey  String           @unique @map("idempotency_key")
  reason          String?
  createdById     BigInt?          @map("created_by")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("StockLedgerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, warehouseId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_ledger")
}

model StockReservation {
  id             BigInt            @id @default(autoincrement())
  orderId        BigInt            @map("order_id")
  orderItemId    BigInt            @map("order_item_id")
  productId      BigInt            @map("product_id")
  warehouseId    BigInt            @map("warehouse_id")
  quantity       BigInt
  status         ReservationStatus @default(ACTIVE)
  idempotencyKey String            @unique @map("idempotency_key")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt     DateTime?         @map("released_at") @db.Timestamptz(6)
  consumedAt     DateTime?         @map("consumed_at") @db.Timestamptz(6)

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([orderId, orderItemId])
  @@index([orderId])
  @@index([productId, warehouseId, status])
  @@map("stock_reservations")
}

// ---------------------------------------------------------------------------
// M7 Transfers
// ---------------------------------------------------------------------------

model StockTransfer {
  id                BigInt         @id @default(autoincrement())
  publicId          String         @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  transferNo        String         @unique @map("transfer_no")
  sourceWarehouseId BigInt         @map("source_warehouse_id")
  destWarehouseId   BigInt         @map("dest_warehouse_id")
  status            TransferStatus @default(DRAFT)
  createdById       BigInt         @map("created_by")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt       DateTime?      @map("completed_at") @db.Timestamptz(6)

  sourceWarehouse Warehouse @relation("TransferSource", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destWarehouse   Warehouse @relation("TransferDest", fields: [destWarehouseId], references: [id], onDelete: Restrict)
  createdBy       User      @relation("StockTransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items         StockTransferItem[]
  statusHistory TransferStatusHistory[]

  @@index([status])
  @@index([sourceWarehouseId])
  @@index([destWarehouseId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         BigInt @id @default(autoincrement())
  transferId BigInt @map("transfer_id")
  productId  BigInt @map("product_id")
  quantity   BigInt

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([transferId, productId])
  @@index([productId])
  @@map("stock_transfer_items")
}

model TransferStatusHistory {
  id          BigInt          @id @default(autoincrement())
  transferId  BigInt          @map("transfer_id")
  fromStatus  TransferStatus? @map("from_status")
  toStatus    TransferStatus  @map("to_status")
  changedById BigInt          @map("changed_by")
  reason      String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  transfer  StockTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  changedBy User          @relation("TransferStatusHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@map("transfer_status_history")
}

/// Atomic stock-transfer command record (Stock Transfer Foundation).
///
/// One IMMUTABLE row per accepted `POST /stock/transfers`: a single product moved
/// atomically from one warehouse to another WITHIN one company. This is distinct
/// from the planned multi-step `stock_transfers` workflow (DRAFT→IN_TRANSIT→
/// RECEIVED, TASK-019); this foundation performs the source-out + destination-in
/// in ONE transaction and correlates the two append-only `stock_ledger` movements
/// (TRANSFER_OUT / TRANSFER_IN) via `reference_type = 'STOCK_TRANSFER',
/// reference_id = this.id`.
///
/// Tenant safety is a DB invariant: `company_id` is carried explicitly and the
/// three composite FKs pin product.company = from.company = to.company = this
/// company, so a cross-company transfer is physically un-insertable (not merely
/// rejected in code). The row is append-only — a `prevent_mutation` trigger blocks
/// UPDATE/DELETE — and idempotent per client: `(company_id, idempotency_key)` is
/// unique, so a replay finds this row and creates no second transfer/movement.
/// `source ≠ destination` and `quantity > 0` are DB CHECKs (manual SQL).
model StockTransferRecord {
  id              BigInt   @id @default(autoincrement())
  publicId        String   @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  companyId       BigInt   @map("company_id")
  productId       BigInt   @map("product_id")
  fromWarehouseId BigInt   @map("from_warehouse_id")
  toWarehouseId   BigInt   @map("to_warehouse_id")
  quantity        BigInt
  reason          String?
  idempotencyKey  String   @map("idempotency_key")
  createdById     BigInt   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Composite FKs pin every endpoint to THIS company. onDelete: Restrict — a
  // product/warehouse that still owns a transfer record cannot be hard-deleted.
  product       Product   @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)
  fromWarehouse Warehouse @relation("StockTransferRecordSource", fields: [fromWarehouseId, companyId], references: [id, companyId], onDelete: Restrict)
  toWarehouse   Warehouse @relation("StockTransferRecordDest", fields: [toWarehouseId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy     User      @relation("StockTransferRecordCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, createdAt])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([productId])
  @@map("stock_transfer_records")
}

// ---------------------------------------------------------------------------
// M8 Customers
// ---------------------------------------------------------------------------

model Customer {
  id        BigInt    @id @default(autoincrement())
  publicId  String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  // Owning tenant (NOT NULL). Customers are company-scoped master data; the code
  // uniqueness, every list/get and all mutations are filtered by this company,
  // resolved from the PostgreSQL principal — never a JWT claim (Customer
  // Management Foundation). Mirrors the products/warehouses tenant model.
  companyId BigInt    @map("company_id")
  code      String
  name      String
  taxNumber String?   @map("tax_number")
  email     String?   @db.Citext
  phone     String?
  type      String    @default("COMPANY")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  addresses CustomerAddress[]
  orders    Order[]
  returns   Return[]
  invoices  Invoice[]
  quotes    Quote[]

  // Customer code identity is (company, code): the same code may exist across
  // companies. The Customer Management Foundation migration converts this to a
  // PARTIAL unique (`WHERE deleted_at IS NULL`), preserving the index name, so
  // within one company an active code is unique while a soft-deleted customer
  // frees its code for reuse (matches the products SKU convention).
  @@unique([companyId, code], map: "customers_code_key")
  // Composite-FK target so orders.(customer_id, company_id) references it and pins
  // every order to its customer's own tenant (Order Draft Foundation), mirroring
  // the warehouse/product (id, company_id) targets.
  @@unique([id, companyId])
  @@index([companyId])
  @@index([taxNumber])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("customers")
}

model CustomerAddress {
  id         BigInt      @id @default(autoincrement())
  customerId BigInt      @map("customer_id")
  type       AddressType
  line1      String
  line2      String?
  city       String?
  state      String?
  postalCode String?     @map("postal_code")
  country    String?     @db.Char(2)
  isDefault  Boolean     @default(false) @map("is_default")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?   @map("deleted_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type])
  @@map("customer_addresses")
}

// ---------------------------------------------------------------------------
// M9 Orders (immutable record)
// ---------------------------------------------------------------------------

model Order {
  id               BigInt      @id @default(autoincrement())
  publicId         String      @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  orderNo          String      @unique @map("order_no")
  // Owning tenant (NOT NULL). Orders are company-scoped transaction data; every
  // list/get and all mutations are filtered by this company, resolved from the
  // PostgreSQL principal — never a JWT claim (Order Draft Foundation). The
  // composite FKs below pin the customer/warehouse to THIS company at the DB layer.
  companyId        BigInt      @map("company_id")
  customerId       BigInt      @map("customer_id")
  warehouseId      BigInt      @map("warehouse_id")
  status           OrderStatus @default(DRAFT)
  currency         String      @default("TRY") @db.Char(3)
  subtotalAmount   BigInt      @default(0) @map("subtotal_amount")
  taxAmount        BigInt      @default(0) @map("tax_amount")
  grandTotalAmount BigInt      @default(0) @map("grand_total_amount")
  notes            String?
  createdById      BigInt      @map("created_by")
  approvedById     BigInt?     @map("approved_by")
  approvedAt       DateTime?   @map("approved_at") @db.Timestamptz(6)
  shippedAt        DateTime?   @map("shipped_at") @db.Timestamptz(6)
  cancelledAt      DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Tenant pin (Order Draft Foundation): the customer and warehouse are addressed
  // by their (id, company_id) composite-unique so a cross-company customer/
  // warehouse is physically un-insertable. onDelete: Restrict — a customer/
  // warehouse that still owns an order cannot be hard-deleted.
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer   Customer  @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  warehouse  Warehouse @relation(fields: [warehouseId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy  User      @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?     @relation("OrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  priceOverrides OrderPriceOverride[]
  reservations   StockReservation[]
  shipments      OrderShipment[]
  invoices       Invoice[]
  returns        Return[]

  // Composite-FK target so order_items.(order_id, company_id) references it and
  // pins every line to the order's own tenant.
  @@unique([id, companyId])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([warehouseId, status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                 BigInt   @id @default(autoincrement())
  orderId            BigInt   @map("order_id")
  // Owning tenant (NOT NULL) — equal to the parent order's company. The two
  // composite FKs below pin this line's order AND product to this same company,
  // so order.company = product.company is a DB invariant (Order Draft Foundation).
  companyId          BigInt   @map("company_id")
  productId          BigInt   @map("product_id")
  productSku         String   @map("product_sku")
  productName        String   @map("product_name")
  quantity           BigInt
  listPriceAmount    BigInt   @map("list_price_amount")
  unitPriceAmount    BigInt   @map("unit_price_amount")
  taxRateBp          Int      @map("tax_rate_bp")
  priceOverridden    Boolean  @default(false) @map("price_overridden")
  lineSubtotalAmount BigInt   @map("line_subtotal_amount")
  lineTaxAmount      BigInt   @map("line_tax_amount")
  lineTotalAmount    BigInt   @map("line_total_amount")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order          Order                @relation(fields: [orderId, companyId], references: [id, companyId], onDelete: Restrict)
  product        Product              @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)
  reservations   StockReservation[]
  priceOverrides OrderPriceOverride[]
  returnItems    ReturnItem[]
  invoiceItems   InvoiceItem[]

  @@unique([orderId, productId])
  @@index([companyId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          BigInt       @id @default(autoincrement())
  orderId     BigInt       @map("order_id")
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  changedById BigInt       @map("changed_by")
  reason      String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User  @relation("OrderStatusHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_status_history")
}

model OrderPriceOverride {
  id                    BigInt   @id @default(autoincrement())
  orderId               BigInt   @map("order_id")
  orderItemId           BigInt   @map("order_item_id")
  originalPriceAmount   BigInt   @map("original_price_amount")
  overriddenPriceAmount BigInt   @map("overridden_price_amount")
  discountPctBp         Int      @map("discount_pct_bp")
  reason                String
  requiresApproval      Boolean  @default(false) @map("requires_approval")
  approvedById          BigInt?  @map("approved_by")
  actorUserId           BigInt   @map("actor_user_id")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order      Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem  OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  actor      User      @relation("OrderPriceOverrideActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  approvedBy User?     @relation("OrderPriceOverrideApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([orderItemId])
  @@map("order_price_overrides")
}

/// Atomic order shipment / stock-commit command record (Order Shipment Foundation).
///
/// One IMMUTABLE row per accepted `POST /orders/:id/ship`: an APPROVED order whose
/// reserved stock is physically committed in ONE transaction (on_hand−, reserved−,
/// each line's ACTIVE reservation → CONSUMED, one SHIPMENT `stock_ledger` movement
/// per line). This is distinct from the planned multi-step shipment workflow; this
/// foundation performs the APPROVED→SHIPPED commit atomically.
///
/// Tenant safety is a DB invariant: `company_id` is carried explicitly and the two
/// composite FKs pin order.company = warehouse.company = this company, so a
/// cross-company shipment is physically un-insertable (not merely rejected in
/// code). The row is append-only — a `prevent_mutation` trigger blocks UPDATE/DELETE
/// — and there is at most ONE shipment per order (`order_id` unique). Idempotent per
/// client: `(company_id, idempotency_key)` is unique, so a same-key replay finds
/// this row and commits no second shipment/movement.
model OrderShipment {
  id             BigInt   @id @default(autoincrement())
  publicId       String   @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  companyId      BigInt   @map("company_id")
  orderId        BigInt   @map("order_id")
  warehouseId    BigInt   @map("warehouse_id")
  status         String   @default("SHIPPED")
  shippedAt      DateTime @default(now()) @map("shipped_at") @db.Timestamptz(6)
  idempotencyKey String   @map("idempotency_key")
  createdById    BigInt   @map("created_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Composite FKs pin both endpoints to THIS company. onDelete: Restrict — an
  // order/warehouse that still owns a shipment cannot be hard-deleted.
  order     Order     @relation(fields: [orderId, companyId], references: [id, companyId], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User      @relation("OrderShipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Idempotency: a replay finds the row by (company, key). At most one shipment per
  // order (order_id unique) — the order row lock + APPROVED→SHIPPED guard is the
  // primary serialiser; this unique is the row-level last-line safety net.
  @@unique([companyId, idempotencyKey])
  @@unique([orderId])
  @@index([companyId, createdAt])
  @@index([warehouseId])
  @@map("order_shipments")
}

model CommandIdempotency {
  key         String   @id
  commandType String   @map("command_type")
  aggregateId BigInt   @map("aggregate_id")
  requestHash String   @map("request_hash")
  status      String
  response    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([commandType, aggregateId, key])
  @@map("command_idempotency")
}

// ---------------------------------------------------------------------------
// M10 Returns
// ---------------------------------------------------------------------------

model Return {
  id          BigInt       @id @default(autoincrement())
  publicId    String       @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  returnNo    String       @unique @map("return_no")
  orderId     BigInt       @map("order_id")
  customerId  BigInt       @map("customer_id")
  status      ReturnStatus @default(DRAFT)
  reason      String?
  createdById BigInt       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  receivedAt  DateTime?    @map("received_at") @db.Timestamptz(6)

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User     @relation("ReturnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items         ReturnItem[]
  statusHistory ReturnStatusHistory[]

  @@index([orderId])
  @@index([status])
  @@map("returns")
}

model ReturnItem {
  id          BigInt          @id @default(autoincrement())
  returnId    BigInt          @map("return_id")
  orderItemId BigInt          @map("order_item_id")
  productId   BigInt          @map("product_id")
  quantity    BigInt
  condition   ReturnCondition
  restock     Boolean         @default(false)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  return    Return    @relation(fields: [returnId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([orderItemId])
  @@map("return_items")
}

model ReturnStatusHistory {
  id          BigInt        @id @default(autoincrement())
  returnId    BigInt        @map("return_id")
  fromStatus  ReturnStatus? @map("from_status")
  toStatus    ReturnStatus  @map("to_status")
  changedById BigInt        @map("changed_by")
  reason      String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  return    Return @relation(fields: [returnId], references: [id], onDelete: Restrict)
  changedBy User   @relation("ReturnStatusHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@map("return_status_history")
}

// ---------------------------------------------------------------------------
// M11 Billing
// ---------------------------------------------------------------------------

model InvoiceSeries {
  id         BigInt   @id @default(autoincrement())
  companyId  BigInt   @map("company_id")
  seriesCode String   @map("series_code")
  fiscalYear Int      @map("fiscal_year")
  prefix     String
  nextNumber BigInt   @default(1) @map("next_number")
  version    Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@unique([companyId, seriesCode, fiscalYear])
  @@map("invoice_series")
}

model Invoice {
  id               BigInt        @id @default(autoincrement())
  publicId         String        @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  seriesId         BigInt?       @map("series_id")
  invoiceNumber    BigInt?       @map("invoice_number")
  invoiceNo        String?       @map("invoice_no")
  docType          DocumentType  @default(INVOICE) @map("doc_type")
  companyId        BigInt        @map("company_id")
  fiscalYear       Int?          @map("fiscal_year")
  customerId       BigInt        @map("customer_id")
  orderId          BigInt?       @map("order_id")
  // Source warehouse (Invoice/Billing Foundation): an order-sourced invoice
  // inherits the order's warehouse so the read endpoints can scope-filter by it,
  // exactly like orders. Carried with `company_id` in a composite FK so the
  // warehouse always belongs to the invoice's tenant. Nullable for future
  // non-order documents (e.g. credit notes) that may not bind a warehouse.
  warehouseId      BigInt?       @map("warehouse_id")
  status           InvoiceStatus @default(DRAFT)
  currency         String        @default("TRY") @db.Char(3)
  subtotalAmount   BigInt        @default(0) @map("subtotal_amount")
  taxAmount        BigInt        @default(0) @map("tax_amount")
  grandTotalAmount BigInt        @default(0) @map("grand_total_amount")
  // Client idempotency key for `POST /orders/:id/invoice` (Invoice/Billing
  // Foundation). A same-key replay returns the existing invoice; a same-key
  // reuse for a different order/payload is a 409. Internal — never in the public
  // contract. Nullable so non-idempotent/legacy invoice creation paths coexist.
  idempotencyKey   String?       @map("idempotency_key")
  issuedAt         DateTime?     @map("issued_at") @db.Timestamptz(6)
  dueDate          DateTime?     @map("due_date") @db.Date
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdById      BigInt        @map("created_by")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  series    InvoiceSeries? @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  customer  Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Composite FK pins the warehouse to THIS company (tenant invariant), like
  // orders.(warehouse_id, company_id). onDelete: Restrict — a warehouse that
  // still owns an invoice cannot be hard-deleted.
  warehouse Warehouse?     @relation(fields: [warehouseId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User           @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items         InvoiceItem[]
  payments      Payment[]
  statusHistory InvoiceStatusHistory[]

  // A-01: gapless invoice numbering uniqueness. NULL invoice_number rows
  // (DRAFT) do not collide under PostgreSQL NULLS DISTINCT semantics.
  @@unique([companyId, seriesId, fiscalYear, invoiceNumber])
  // Client idempotency replay: at most one invoice per (company, key). NULL keys
  // do not collide (NULLS DISTINCT), so legacy keyless invoices coexist.
  @@unique([companyId, idempotencyKey])
  // At most one ACTIVE (non-VOID) invoice per (company, order). The init/Billing
  // migration converts this to a PARTIAL unique
  // (`WHERE order_id IS NOT NULL AND status <> 'VOID'`), preserving the index
  // name, so a re-invoice after VOID is allowed while a duplicate active invoice
  // for the same order is blocked. Prisma cannot model the predicate, so the
  // structural drift diff sees a plain unique (allowlisted in drift-eval).
  @@unique([companyId, orderId], map: "invoices_company_id_order_id_active_key")
  @@index([customerId])
  @@index([status])
  @@index([orderId])
  @@index([warehouseId])
  @@index([issuedAt])
  @@map("invoices")
}

model InvoiceItem {
  id                 BigInt  @id @default(autoincrement())
  invoiceId          BigInt  @map("invoice_id")
  productId          BigInt? @map("product_id")
  // Source order line (Invoice/Billing Foundation): an order-sourced invoice line
  // is a frozen snapshot of an order_items row; this links back for traceability.
  // Nullable + SET NULL so deleting the order line never blocks/erases the issued
  // invoice (an issued invoice is immutable — INVOICE_RULES §2).
  orderItemId        BigInt? @map("order_item_id")
  description        String
  quantity           BigInt
  unitPriceAmount    BigInt  @map("unit_price_amount")
  taxRateBp          Int     @map("tax_rate_bp")
  lineSubtotalAmount BigInt  @map("line_subtotal_amount")
  lineTaxAmount      BigInt  @map("line_tax_amount")
  lineTotalAmount    BigInt  @map("line_total_amount")

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  product   Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([orderItemId])
  @@map("invoice_items")
}

model InvoiceStatusHistory {
  id          BigInt         @id @default(autoincrement())
  invoiceId   BigInt         @map("invoice_id")
  fromStatus  InvoiceStatus? @map("from_status")
  toStatus    InvoiceStatus  @map("to_status")
  changedById BigInt         @map("changed_by")
  reason      String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  changedBy User    @relation("InvoiceStatusHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("invoice_status_history")
}

model Quote {
  id               BigInt      @id @default(autoincrement())
  publicId         String      @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  quoteNo          String      @unique @map("quote_no")
  customerId       BigInt      @map("customer_id")
  status           QuoteStatus @default(DRAFT)
  currency         String      @default("TRY") @db.Char(3)
  subtotalAmount   BigInt      @default(0) @map("subtotal_amount")
  taxAmount        BigInt      @default(0) @map("tax_amount")
  grandTotalAmount BigInt      @default(0) @map("grand_total_amount")
  validUntil       DateTime?   @map("valid_until") @db.Date
  createdById      BigInt      @map("created_by")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User     @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items QuoteItem[]

  @@index([customerId])
  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id              BigInt  @id @default(autoincrement())
  quoteId         BigInt  @map("quote_id")
  productId       BigInt? @map("product_id")
  description     String
  quantity        BigInt
  unitPriceAmount BigInt  @map("unit_price_amount")
  taxRateBp       Int     @map("tax_rate_bp")
  lineTotalAmount BigInt  @map("line_total_amount")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_items")
}

model Payment {
  id          BigInt   @id @default(autoincrement())
  invoiceId   BigInt   @map("invoice_id")
  amount      BigInt
  currency    String   @default("TRY") @db.Char(3)
  method      String
  paidAt      DateTime @map("paid_at") @db.Timestamptz(6)
  createdById BigInt   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy User    @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// M12 Files
// ---------------------------------------------------------------------------

model File {
  id             BigInt    @id @default(autoincrement())
  publicId       String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  storageKey     String    @unique @map("storage_key")
  bucket         String
  filename       String
  contentType    String    @map("content_type")
  sizeBytes      BigInt    @map("size_bytes")
  checksumSha256 String?   @map("checksum_sha256")
  entityType     String?   @map("entity_type")
  entityId       BigInt?   @map("entity_id")
  uploadedById   BigInt    @map("uploaded_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  uploadedBy User @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  importJobsSource ImportJob[]     @relation("ImportJobSourceFile")
  importJobsResult ImportJob[]     @relation("ImportJobResultFile")
  exportJobs       ExportJob[]
  effectReceipts   EffectReceipt[] @relation("EffectReceiptOutputFile")

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@map("files")
}

// ---------------------------------------------------------------------------
// M14/M15 Imports / Exports
// ---------------------------------------------------------------------------

model ImportJob {
  id                 BigInt       @id @default(autoincrement())
  companyId          BigInt       @map("company_id")
  type               String
  sourceFileId       BigInt       @map("source_file_id")
  fileChecksumSha256 String       @map("file_checksum_sha256")
  status             ImportStatus @default(UPLOADED)
  applyPolicy        String       @default("ALL_OR_NOTHING") @map("apply_policy")
  totalRows          Int          @default(0) @map("total_rows")
  validRows          Int          @default(0) @map("valid_rows")
  invalidRows        Int          @default(0) @map("invalid_rows")
  appliedRows        Int          @default(0) @map("applied_rows")
  resultFileId       BigInt?      @map("result_file_id")
  // Crash-recovery / replay (A-09): a terminal import can be retried as a new
  // attempt linked to the original via replayOfImportId. Lease + heartbeat let
  // a worker reclaim a job whose previous owner died mid-import.
  replayOfImportId   BigInt?      @map("replay_of_import_id")
  attemptNumber      Int          @default(1) @map("attempt_number")
  resumedFromRow     Int?         @map("resumed_from_row")
  leaseExpiresAt     DateTime?    @map("lease_expires_at") @db.Timestamptz(6)
  heartbeatAt        DateTime?    @map("heartbeat_at") @db.Timestamptz(6)
  createdById        BigInt       @map("created_by")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceFile File        @relation("ImportJobSourceFile", fields: [sourceFileId], references: [id], onDelete: Restrict)
  resultFile File?       @relation("ImportJobResultFile", fields: [resultFileId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("ImportJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  replayOf   ImportJob?  @relation("ImportJobReplay", fields: [replayOfImportId], references: [id], onDelete: Restrict)
  replays    ImportJob[] @relation("ImportJobReplay")

  rows   ImportRow[]
  errors ImportJobError[]

  @@index([status])
  @@index([companyId])
  @@index([replayOfImportId])
  @@index([type, fileChecksumSha256])
  @@map("import_jobs")
}

model ImportRow {
  id             BigInt          @id @default(autoincrement())
  importJobId    BigInt          @map("import_job_id")
  rowNumber      Int             @map("row_number")
  rowHash        String          @map("row_hash")
  idempotencyKey String          @unique @map("idempotency_key")
  rawData        Json            @map("raw_data") @db.JsonB
  parsedData     Json?           @map("parsed_data") @db.JsonB
  status         ImportRowStatus @default(PENDING)
  warehouseId    BigInt?         @map("warehouse_id")
  errorMessage   String?         @map("error_message")

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Restrict)

  @@unique([importJobId, rowNumber])
  @@index([importJobId, status])
  @@map("import_rows")
}

model ImportJobError {
  id          BigInt   @id @default(autoincrement())
  importJobId BigInt   @map("import_job_id")
  importRowId BigInt?  @map("import_row_id")
  rowNumber   Int      @map("row_number")
  column      String?
  message     String
  rawData     Json     @map("raw_data") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Restrict)

  @@index([importJobId])
  @@map("import_job_errors")
}

model ExportJob {
  id          BigInt    @id @default(autoincrement())
  type        String
  format      String
  params      Json      @db.JsonB
  status      JobStatus @default(PENDING)
  fileId      BigInt?   @map("file_id")
  createdById BigInt    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  file      File? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdBy User  @relation("ExportJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("export_jobs")
}

// ---------------------------------------------------------------------------
// M16/M17 Outbox / Effects / Notifications / Email
// ---------------------------------------------------------------------------

model OutboxEvent {
  id               BigInt       @id @default(autoincrement())
  eventType        String       @map("event_type")
  aggregateType    String       @map("aggregate_type")
  aggregateId      BigInt       @map("aggregate_id")
  deduplicationKey String       @unique @map("deduplication_key")
  payload          Json         @db.JsonB
  status           OutboxStatus @default(PENDING)
  attempts         Int          @default(0)
  availableAt      DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt         DateTime?    @map("locked_at") @db.Timestamptz(6)
  processedAt      DateTime?    @map("processed_at") @db.Timestamptz(6)
  lastError        String?      @map("last_error")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  // One outbox event may spawn several side effects (email + pdf + …); the
  // relation is one-to-many. Receipts are RESTRICT-bound so an event whose
  // effects exist can never be deleted (auditability — DATABASE_DESIGN §14).
  effects EffectReceipt[]

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model EffectReceipt {
  id                     BigInt       @id @default(autoincrement())
  outboxEventId          BigInt       @map("outbox_event_id")
  effectType             String       @map("effect_type")
  effectKey              String       @map("effect_key")
  providerIdempotencyKey String       @map("provider_idempotency_key")
  status                 EffectStatus @default(PLANNED)
  providerMessageId      String?      @map("provider_message_id")
  outputFileId           BigInt?      @map("output_file_id")
  attempts               Int          @default(0)
  lastError              String?      @map("last_error")
  completedAt            DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  outboxEvent OutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)
  outputFile  File?       @relation("EffectReceiptOutputFile", fields: [outputFileId], references: [id], onDelete: SetNull)

  // effect_key dedupes the *effect*; (effect_type, provider_idempotency_key)
  // dedupes the *provider call* within its provider scope (ADR-008).
  @@unique([effectType, effectKey])
  @@unique([effectType, providerIdempotencyKey])
  @@index([outboxEventId])
  @@index([status])
  @@map("effect_receipts")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  type      String
  title     String
  body      String?
  data      Json?     @db.JsonB
  dedupKey  String    @map("dedup_key")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model EmailMessage {
  id                BigInt      @id @default(autoincrement())
  toEmail           String      @map("to_email")
  subject           String
  template          String
  payload           Json        @db.JsonB
  idempotencyKey    String      @unique @map("idempotency_key")
  status            EmailStatus @default(QUEUED)
  providerMessageId String?     @map("provider_message_id")
  error             String?
  attempts          Int         @default(0)
  sentAt            DateTime?   @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@map("email_messages")
}

// ---------------------------------------------------------------------------
// M18/M20 Audit & system
// ---------------------------------------------------------------------------

model AuditLog {
  id                 BigInt   @id @default(autoincrement())
  actorId            BigInt?  @map("actor_id")
  actorEmail         String?  @map("actor_email")
  actorName          String?  @map("actor_name")
  actorRolesSnapshot Json?    @map("actor_roles_snapshot") @db.JsonB
  action             String
  entityType         String?  @map("entity_type")
  entityId           BigInt?  @map("entity_id")
  before             Json?    @db.JsonB
  after              Json?    @db.JsonB
  ip                 String?  @db.Inet
  userAgent          String?  @map("user_agent")
  requestId          String?  @map("request_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

model JobLog {
  id         BigInt    @id @default(autoincrement())
  queue      String
  jobId      String    @map("job_id")
  name       String
  status     JobStatus @default(PENDING)
  attempts   Int       @default(0)
  error      String?
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([queue, status])
  @@index([jobId])
  @@map("job_logs")
}

model IdempotencyKey {
  key         String   @id
  requestHash String   @map("request_hash")
  response    Json?    @db.JsonB
  status      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("idempotency_keys")
}
