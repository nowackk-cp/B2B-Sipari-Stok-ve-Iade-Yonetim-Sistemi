{
  "name": "@b2b/api",
  "version": "0.0.0",
  "private": true,
  "description": "B2B Operations Suite REST API (NestJS).",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run",
    "openapi:json": "node dist/openapi.js",
    "clean": "node -e \"['dist','.turbo','tsconfig.build.tsbuildinfo','tsconfig.tsbuildinfo','openapi.json'].forEach(p=>require('fs').rmSync(p,{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@b2b/config": "workspace:*",
    "@b2b/logger": "workspace:*",
    "@b2b/contracts": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "8.1.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.15",
    "@swc/core": "1.10.1",
    "@types/express": "5.0.0",
    "@types/node": "20.17.10",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "typescript": "5.6.3",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.8"
  }
}
