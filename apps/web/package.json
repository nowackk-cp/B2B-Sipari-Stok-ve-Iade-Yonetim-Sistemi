{
  "name": "@b2b/web",
  "version": "0.0.0",
  "private": true,
  "description": "B2B Operations Suite web app (Next.js App Router) — foundation shell.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "clean": "node -e \"['.next','.turbo','tsconfig.tsbuildinfo','next-env.d.ts','playwright-report','test-results'].forEach(p=>require('fs').rmSync(p,{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@b2b/api-client": "workspace:*",
    "@b2b/config": "workspace:*",
    "@b2b/contracts": "workspace:*",
    "@b2b/ui": "workspace:*",
    "next": "14.2.21",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "20.17.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "typescript": "5.6.3"
  }
}
