{
  "name": "@b2b/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end test harness (Playwright). Full browser flows land in Phase 7.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node -e \"['playwright-report','test-results','.turbo','tsconfig.tsbuildinfo'].forEach(p=>require('fs').rmSync(p,{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@b2b/api-client": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "20.17.10",
    "typescript": "5.6.3"
  }
}
