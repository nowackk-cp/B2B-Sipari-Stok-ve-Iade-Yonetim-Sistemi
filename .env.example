# =============================================================================
# B2B Operations Suite — environment template
# =============================================================================
# Copy to `.env` for local development:  cp .env.example .env
#
# All values below are DEVELOPMENT defaults and are safe to commit ONLY because
# they contain no real secrets. NEVER put production credentials in this file or
# in the repository. See "Production secret management" at the bottom.
#
# Validation is enforced by @b2b/config (zod). A missing/invalid required value
# makes the affected service fail fast at boot.
# =============================================================================

# --- common (all services) ---------------------------------------------------
NODE_ENV=development
APP_NAME=b2b-operations-suite
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- postgres ----------------------------------------------------------------
# Used by api, worker and Prisma. Must be a postgres:// connection string.
DATABASE_URL=postgresql://b2b:b2b_dev_password@localhost:5432/b2b
# Consumed by docker-compose to provision the dev database:
POSTGRES_USER=b2b
POSTGRES_PASSWORD=b2b_dev_password
POSTGRES_DB=b2b
POSTGRES_PORT=5432

# --- redis (queue / cache) ---------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- storage (MinIO in dev, S3-compatible in prod) ---------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=b2b_minio
S3_SECRET_ACCESS_KEY=b2b_minio_dev_password
S3_BUCKET=b2b-files
S3_FORCE_PATH_STYLE=true
# docker-compose MinIO root credentials (match the access keys above in dev):
MINIO_ROOT_USER=b2b_minio
MINIO_ROOT_PASSWORD=b2b_minio_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- mail (Mailpit in dev, SMTP/SES in prod) ---------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=B2B Operations <no-reply@b2bops.local>
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- api ---------------------------------------------------------------------
API_PORT=3001
# Comma-separated list of allowed CORS origins.
API_CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# --- worker ------------------------------------------------------------------
WORKER_CONCURRENCY=5
WORKER_QUEUE_PREFIX=b2b
# Optional stable id; derived from hostname+pid when unset.
# WORKER_INSTANCE_ID=

# --- web (browser-exposed; must be prefixed NEXT_PUBLIC_) ---------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# =============================================================================
# Production secret management
# =============================================================================
# - Do NOT commit production values. Provide them via your platform's secret
#   manager (e.g. AWS Secrets Manager / SSM, GCP Secret Manager, Vault, or
#   GitHub Actions encrypted secrets) and inject as environment variables.
# - Rotate DATABASE_URL, S3 keys and SMTP credentials regularly.
# - Use strong, unique passwords; never reuse the development defaults above.
# - In production set NODE_ENV=production and SWAGGER_ENABLED behind auth (or
#   disabled). Logs already redact authorization/cookie/password/token fields.
# =============================================================================
