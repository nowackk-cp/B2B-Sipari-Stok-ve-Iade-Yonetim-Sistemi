# =============================================================================
# B2B Operations Suite — environment template
# =============================================================================
# Copy to `.env` for local development:  cp .env.example .env
#
# All values below are DEVELOPMENT defaults and are safe to commit ONLY because
# they contain no real secrets. NEVER put production credentials in this file or
# in the repository. See "Production secret management" at the bottom.
#
# Validation is enforced by @b2b/config (zod). A missing/invalid required value
# makes the affected service fail fast at boot.
# =============================================================================

# --- common (all services) ---------------------------------------------------
NODE_ENV=development
APP_NAME=b2b-operations-suite
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- postgres ----------------------------------------------------------------
# Used by api, worker and Prisma. Must be a postgres:// connection string.
DATABASE_URL=postgresql://b2b:b2b_dev_password@localhost:5432/b2b
# Consumed by docker-compose to provision the dev database:
POSTGRES_USER=b2b
POSTGRES_PASSWORD=b2b_dev_password
POSTGRES_DB=b2b
POSTGRES_PORT=5432

# --- redis (queue / cache) ---------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- storage (MinIO in dev, S3-compatible in prod) ---------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=b2b_minio
S3_SECRET_ACCESS_KEY=b2b_minio_dev_password
S3_BUCKET=b2b-files
S3_FORCE_PATH_STYLE=true
# docker-compose MinIO root credentials (match the access keys above in dev):
MINIO_ROOT_USER=b2b_minio
MINIO_ROOT_PASSWORD=b2b_minio_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- mail (Mailpit in dev, SMTP/SES in prod) ---------------------------------
# Dev defaults target Mailpit (unauthenticated). In production SMTP_USER and
# SMTP_PASSWORD are REQUIRED — @b2b/config fails fast at boot without them so a
# real password-reset email can never silently fall back to an unauthenticated
# relay or a fake transport.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=B2B Operations <no-reply@b2bops.local>
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- api ---------------------------------------------------------------------
API_PORT=3001
# Comma-separated list of allowed CORS origins.
API_CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# --- auth (identity / tokens / account security) -----------------------------
# Access-token signing secret (HS256 this milestone). MUST be >= 32 chars; the
# value below is a DEV-ONLY placeholder — generate a strong unique secret in
# production (e.g. `openssl rand -base64 48`) and inject via the secret manager.
JWT_ACCESS_SECRET=dev-only-insecure-access-secret-change-me-32+
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=b2b-operations-suite
JWT_AUDIENCE=b2b-api
REFRESH_TOKEN_TTL_DAYS=30
# argon2id parameters (OWASP-aligned). Raise memory/iterations as hardware allows.
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1
PASSWORD_RESET_TTL_MINUTES=30
# AES-256-GCM key sealing the deliverable reset token (the raw token is NEVER
# stored in plaintext). MUST be >= 32 bytes and live ONLY in the environment —
# never the database. Generate a strong unique value (e.g. `openssl rand -base64 48`).
PASSWORD_RESET_DELIVERY_KEY=dev-only-insecure-reset-delivery-key-change-me-32+
# Durable per-account lockout (authoritative in PostgreSQL).
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_MINUTES=15
# Redis-backed login throttle (secondary defense; per IP and per identifier).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Refresh cookie. COOKIE_SECURE defaults to true in production when unset.
# COOKIE_SECURE=false
# COOKIE_DOMAIN=
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_NAME=b2b_refresh_token

# --- worker ------------------------------------------------------------------
WORKER_CONCURRENCY=5
WORKER_QUEUE_PREFIX=b2b
# Optional stable id; derived from hostname+pid when unset.
# WORKER_INSTANCE_ID=

# --- web (browser-exposed; must be prefixed NEXT_PUBLIC_) ---------------------
# NOTE: NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time,
# not at `next start`. If you change this for a different API host, rebuild the
# web app. The web E2E harness (apps/web/playwright.config.ts) sets it for its
# own build automatically.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# --- bootstrap admin (optional; seed-gated SYSTEM_ADMIN) ----------------------
# Set BOTH to have `db:seed` create a SYSTEM_ADMIN demo user (see DEMO_RUNBOOK
# §6). The hash MUST be a pre-computed argon2id encoding — the seed never handles
# plaintext and never resets an existing user's password. Leave unset to skip.
# BOOTSTRAP_ADMIN_EMAIL=admin@demo.local
# BOOTSTRAP_ADMIN_PASSWORD_HASH=
# BOOTSTRAP_ADMIN_NAME=Demo Admin

# --- web E2E (Playwright; TEST DATABASES ONLY) -------------------------------
# Deterministic credentials for the seeded E2E user (apps/api/scripts/
# seed-e2e-user.mjs). These are TEST-ONLY placeholders, never real secrets, and
# the seed refuses any database whose name does not contain "test". The plaintext
# password is only used at runtime to derive an argon2id hash; the DB stores the
# hash. The E2E suite also needs DATABASE_URL pointing at a real *test* PostgreSQL
# (name must contain "test"); PASSWORD_RESET_DELIVERY_KEY and JWT_ACCESS_SECRET
# are defaulted to throwaway values by the Playwright config when unset.
E2E_USER_EMAIL=e2e@test.local
E2E_USER_PASSWORD=e2e correct horse staple
# E2E_USER_NAME=E2E User
# E2E_WAREHOUSE_CODE=MAIN

# =============================================================================
# Production secret management
# =============================================================================
# - Do NOT commit production values. Provide them via your platform's secret
#   manager (e.g. AWS Secrets Manager / SSM, GCP Secret Manager, Vault, or
#   GitHub Actions encrypted secrets) and inject as environment variables.
# - Rotate DATABASE_URL, S3 keys and SMTP credentials regularly.
# - Use strong, unique passwords; never reuse the development defaults above.
# - In production set NODE_ENV=production and SWAGGER_ENABLED behind auth (or
#   disabled). Logs already redact authorization/cookie/password/token fields.
# =============================================================================
